GRIDSHARD_RUNTIME_MODE=development
GRIDSHARD_AUTH_SIGNING_KEY=replace-with-at-least-32-random-characters
GRIDSHARD_POSTGRES_PASSWORD=replace-local-password
DATABASE_URL=postgresql://gridshard:replace-local-password@localhost:5432/gridshard
REDIS_URL=redis://localhost:6379/0
GRIDSHARD_CORS_ORIGINS=https://localhost,capacitor://localhost

# Yalnız yerel geliştirmede doğrulama kodunu istemciye döndürür. Üretimde 0 olmalıdır.
GRIDSHARD_DEV_EXPOSE_VERIFICATION_CODES=1
GRIDSHARD_EMAIL_PROVIDER=

# Gerçek mağaza girişleri için sağlayıcı panellerinden alınacak değerler.
GRIDSHARD_GOOGLE_OAUTH_CLIENT_ID=
GRIDSHARD_GOOGLE_OAUTH_AUTHORIZE_URL=
GRIDSHARD_GOOGLE_OAUTH_REDIRECT_URI=
GRIDSHARD_APPLE_OAUTH_CLIENT_ID=
GRIDSHARD_APPLE_OAUTH_AUTHORIZE_URL=
GRIDSHARD_APPLE_OAUTH_REDIRECT_URI=
