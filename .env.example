GRIDSHARD_RUNTIME_MODE=development
GRIDSHARD_AUTH_SIGNING_KEY=replace-with-at-least-32-random-characters
GRIDSHARD_POSTGRES_PASSWORD=replace-local-password
DATABASE_URL=postgresql://gridshard:replace-local-password@localhost:5432/gridshard
REDIS_URL=redis://localhost:6379/0
GRIDSHARD_CORS_ORIGINS=https://localhost,capacitor://localhost

# Play Console'da oluşturulan kalıcı Android paket kimliği.
# Mobil derleme/yayın kapısı ile Google Play makbuz doğrulaması aynı adı kullanır.
GRIDSHARD_APP_ID=com.gridshardgame.app

# Yalnız yerel geliştirmede doğrulama kodunu istemciye döndürür. Üretimde 0 olmalıdır.
GRIDSHARD_DEV_EXPOSE_VERIFICATION_CODES=1
GRIDSHARD_PUBLIC_WEB_URL=http://127.0.0.1:8000

# Gmail/Google Workspace SMTP örneği. Parola olarak normal hesap parolasını
# değil, 2 Adımlı Doğrulama açıkken oluşturulan uygulama parolasını kullanın.
GRIDSHARD_EMAIL_PROVIDER=smtp
GRIDSHARD_SMTP_HOST=smtp.gmail.com
GRIDSHARD_SMTP_PORT=587
GRIDSHARD_SMTP_USERNAME=
GRIDSHARD_SMTP_PASSWORD=
GRIDSHARD_SMTP_FROM=
GRIDSHARD_SMTP_STARTTLS=1

# Gerçek mağaza girişleri için sağlayıcı panellerinden alınacak değerler.
# Android Play Games v2 (separate from browser Google OAuth).
GRIDSHARD_PLAY_GAMES_ID=
GRIDSHARD_PLAY_GAMES_SERVER_CLIENT_ID=
GRIDSHARD_PLAY_GAMES_CLIENT_SECRET_FILE=
GRIDSHARD_GOOGLE_OAUTH_CLIENT_ID=
GRIDSHARD_GOOGLE_OAUTH_CLIENT_SECRET=
GRIDSHARD_GOOGLE_OAUTH_CLIENT_SECRET_FILE=
GRIDSHARD_GOOGLE_OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
GRIDSHARD_GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GRIDSHARD_GOOGLE_OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
GRIDSHARD_GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/google/callback
GRIDSHARD_APPLE_OAUTH_CLIENT_ID=
GRIDSHARD_APPLE_OAUTH_CLIENT_SECRET=
GRIDSHARD_APPLE_OAUTH_CLIENT_SECRET_FILE=
GRIDSHARD_APPLE_OAUTH_TEAM_ID=
GRIDSHARD_APPLE_OAUTH_KEY_ID=
GRIDSHARD_APPLE_OAUTH_PRIVATE_KEY=
GRIDSHARD_APPLE_OAUTH_PRIVATE_KEY_FILE=
GRIDSHARD_APPLE_OAUTH_AUTHORIZE_URL=https://appleid.apple.com/auth/authorize
GRIDSHARD_APPLE_OAUTH_TOKEN_URL=https://appleid.apple.com/auth/token
GRIDSHARD_APPLE_OAUTH_JWKS_URL=https://appleid.apple.com/auth/keys
GRIDSHARD_APPLE_OAUTH_ISSUER=https://appleid.apple.com
GRIDSHARD_APPLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/apple/callback

# Herkese açık imza sertifikası SHA-256 özetleri; özel anahtar değildir.
# Gerçek HTTPS native giriş dönüşü için docs/NATIVE_OAUTH.md.
GRIDSHARD_ANDROID_AUTH_CERT_SHA256=
GRIDSHARD_ANDROID_TEST_AUTH_CERT_SHA256=

# Mobil push varsayılan kapalıdır. Ayrıntılar: docs/PUSH_NOTIFICATIONS.md
# Bunlar OAuth kimlik bilgileri değildir. Anahtarları repoya/istemciye koymayın.
GRIDSHARD_PUSH_ENABLED=0
GRIDSHARD_FCM_SERVICE_ACCOUNT_FILE=
GRIDSHARD_APNS_PRIVATE_KEY_FILE=
GRIDSHARD_APNS_TEAM_ID=
GRIDSHARD_APNS_KEY_ID=
GRIDSHARD_APNS_TOPIC=
# sandbox veya production; iOS imzasının aps-environment değeriyle eşleşmeli.
GRIDSHARD_APNS_ENVIRONMENT=

# Ürün analitiği saklama süresi (gün). Boş: üretimde 180, geliştirmede 0 (süre
# sınırı yok). Onay ve şema: docs/ANALYTICS.md
GRIDSHARD_TELEMETRY_RETENTION_DAYS=

# Gerçek para alımı ve ödüllü reklam. Ayrıntılar: docs/STORE_PURCHASES.md
# Deneme sağlayıcıları boş bırakılınca çalışma kipine göre seçilir (üretimde kapalı).
GRIDSHARD_PURCHASE_TEST_MODE=
GRIDSHARD_AD_TEST_MODE=
GRIDSHARD_GOOGLE_PLAY_PACKAGE_NAME=com.gridshardgame.app
GRIDSHARD_GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GRIDSHARD_APP_STORE_ISSUER_ID=
GRIDSHARD_APP_STORE_KEY_ID=
GRIDSHARD_APP_STORE_PRIVATE_KEY_FILE=
GRIDSHARD_APP_STORE_BUNDLE_ID=
# production veya sandbox (TestFlight ve Sandbox hesapları).
GRIDSHARD_APP_STORE_ENVIRONMENT=production
# Apple kök sertifikaları (ör. AppleRootCA-G3.cer), virgülle.
GRIDSHARD_APPLE_ROOT_CA_FILES=
# Google Play iade bildirimleri (Pub/Sub itme aboneliği, OIDC kimlik doğrulaması).
GRIDSHARD_GOOGLE_RTDN_AUDIENCE=
GRIDSHARD_GOOGLE_RTDN_SERVICE_ACCOUNT=
# Mağazada kaçırılmış iadeleri yeniden tarama aralığı; 0 kapatır (en az 300 saniye).
GRIDSHARD_STORE_RECONCILE_INTERVAL_SECONDS=1800
# Android normal ödüllü reklam birimi; kimliği yazmak reklamları etkinleştirmez.
# Gerçek HTTPS SSV/UMP/test cihazı doğrulaması tamamlanmadan aşağıdaki 0 korunmalı.
GRIDSHARD_ADMOB_SSV_ENABLED=0
# Verifier availability alone never enables client ads. Test rollout needs an
# explicit private account allowlist and the child-safe-v1 native protocol.
GRIDSHARD_ADMOB_ROLLOUT_MODE=disabled
GRIDSHARD_ADMOB_TEST_PLAYER_IDS=
# Yeni bireysel AdMob hesabının Android normal ödüllü reklam birimi (canlı SSV kapalı).
GRIDSHARD_ADMOB_REWARDED_AD_UNIT_ANDROID=ca-app-pub-4974825529326987/6776291719
GRIDSHARD_ADMOB_REWARDED_AD_UNIT_IOS=
