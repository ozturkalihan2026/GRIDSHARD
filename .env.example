GRIDSHARD_RUNTIME_MODE=development
GRIDSHARD_AUTH_SIGNING_KEY=replace-with-at-least-32-random-characters
GRIDSHARD_POSTGRES_PASSWORD=replace-local-password
DATABASE_URL=postgresql://gridshard:replace-local-password@localhost:5432/gridshard
REDIS_URL=redis://localhost:6379/0
GRIDSHARD_CORS_ORIGINS=https://localhost,capacitor://localhost

# Yalnız yerel geliştirmede doğrulama kodunu istemciye döndürür. Üretimde 0 olmalıdır.
GRIDSHARD_DEV_EXPOSE_VERIFICATION_CODES=1
GRIDSHARD_PUBLIC_WEB_URL=http://127.0.0.1:8000

# Gmail/Google Workspace SMTP örneği. Parola olarak normal hesap parolasını
# değil, 2 Adımlı Doğrulama açıkken oluşturulan uygulama parolasını kullanın.
GRIDSHARD_EMAIL_PROVIDER=smtp
GRIDSHARD_SMTP_HOST=smtp.gmail.com
GRIDSHARD_SMTP_PORT=587
GRIDSHARD_SMTP_USERNAME=
GRIDSHARD_SMTP_PASSWORD=
GRIDSHARD_SMTP_FROM=
GRIDSHARD_SMTP_STARTTLS=1

# Gerçek mağaza girişleri için sağlayıcı panellerinden alınacak değerler.
GRIDSHARD_GOOGLE_OAUTH_CLIENT_ID=
GRIDSHARD_GOOGLE_OAUTH_CLIENT_SECRET=
GRIDSHARD_GOOGLE_OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
GRIDSHARD_GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GRIDSHARD_GOOGLE_OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
GRIDSHARD_GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/google/callback
GRIDSHARD_APPLE_OAUTH_CLIENT_ID=
GRIDSHARD_APPLE_OAUTH_CLIENT_SECRET=
GRIDSHARD_APPLE_OAUTH_TEAM_ID=
GRIDSHARD_APPLE_OAUTH_KEY_ID=
GRIDSHARD_APPLE_OAUTH_PRIVATE_KEY=
GRIDSHARD_APPLE_OAUTH_PRIVATE_KEY_FILE=
GRIDSHARD_APPLE_OAUTH_AUTHORIZE_URL=https://appleid.apple.com/auth/authorize
GRIDSHARD_APPLE_OAUTH_TOKEN_URL=https://appleid.apple.com/auth/token
GRIDSHARD_APPLE_OAUTH_JWKS_URL=https://appleid.apple.com/auth/keys
GRIDSHARD_APPLE_OAUTH_ISSUER=https://appleid.apple.com
GRIDSHARD_APPLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/apple/callback

# Mobil push varsayılan kapalıdır. Ayrıntılar: docs/PUSH_NOTIFICATIONS.md
# Bunlar OAuth kimlik bilgileri değildir. Anahtarları repoya/istemciye koymayın.
GRIDSHARD_PUSH_ENABLED=0
GRIDSHARD_FCM_SERVICE_ACCOUNT_FILE=
GRIDSHARD_APNS_PRIVATE_KEY_FILE=
GRIDSHARD_APNS_TEAM_ID=
GRIDSHARD_APNS_KEY_ID=
GRIDSHARD_APNS_TOPIC=
# sandbox veya production; iOS imzasının aps-environment değeriyle eşleşmeli.
GRIDSHARD_APNS_ENVIRONMENT=
