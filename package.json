{
  "name": "gridshard",
  "version": "2.1.0-beta.43",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "test:client": "cd client && node --test tests/*.test.js",
    "test:build": "node --test tools/tests/client-build.test.js",
    "build:web": "node tools/build-client.js",
    "assets:audio": "node tools/prepare-mobile-audio.js",
    "build:mobile:web": "node tools/build-mobile-web.js",
    "mobile:add:android": "pnpm build:mobile:web && cap add android && node tools/configure-native-orientation.js android",
    "mobile:add:ios": "pnpm build:mobile:web && cap add ios && node tools/configure-native-orientation.js ios",
    "mobile:sync:android": "pnpm build:mobile:web && cap sync android",
    "mobile:sync:ios": "pnpm build:mobile:web && cap sync ios",
    "capacitor:sync:after": "node tools/configure-native-orientation.js",
    "test:e2e": "playwright test",
    "test:e2e:pvp": "playwright test --project=desktop-chromium",
    "test:e2e:mobile": "playwright test --project=android-chrome-emulated --project=iphone-safari-emulated",
    "test:e2e:real-device": "node e2e/real-device-browserstack.js"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "1.62.1",
    "esbuild": "0.28.2",
    "selenium-webdriver": "4.47.0"
  }
}
